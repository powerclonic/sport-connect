MYSQL_DATABASE=sportconnect
MYSQL_USER=sportconnect
MYSQL_PASSWORD=sportconnect
MYSQL_ROOT_PASSWORD=rootpassword
# Must be at least 32 characters — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-strong-random-secret-key-32chars
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_ENV=development
# Set to 'true' when running behind HTTPS in production
HTTPS=false
# OAuth credentials (leave empty to disable provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000